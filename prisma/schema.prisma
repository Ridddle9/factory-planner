// Factory Planner — схема данных

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Авторизация ---

model Company {
  id        String   @id @default(cuid())
  inn       String   @unique
  name      String
  syncToken String   @unique
  createdAt DateTime @default(now())

  users                User[]
  workshops            Workshop[]
  categories           ProductCategory[]
  teams                Team[]
  products             Product[]
  orders               Order[]
  categoryBlocks       CategoryBlock[]
  productTeamCapacities ProductTeamCapacity[]
}

// role: ADMIN | MEMBER
// status: PENDING | APPROVED | REJECTED
model User {
  id           String   @id @default(cuid())
  email        String
  passwordHash String
  role         String   @default("MEMBER")
  status       String   @default("PENDING")
  companyId    String
  createdAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([email, companyId])
}

// --- Справочники ---

model Workshop {
  id        String  @id @default(cuid())
  name      String
  companyId String
  visible   Boolean @default(true)

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categories ProductCategory[]

  @@unique([name, companyId])
}

model ProductCategory {
  id                    String  @id @default(cuid())
  name                  String
  capacityPerTeamPerDay Int
  workshopId            String
  companyId             String
  visible               Boolean @default(true)

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  teams    CategoryTeam[]
  products Product[]
  blocks   CategoryBlock[]

  @@unique([name, companyId])
}

// Блокировка категории на период (нет запчастей, плановый простой и т.п.)
model CategoryBlock {
  id         String   @id @default(cuid())
  categoryId String
  companyId  String
  startDate  DateTime
  endDate    DateTime
  reason     String?

  category ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Team {
  id        String @id @default(cuid())
  name      String
  headcount Int    @default(1)
  companyId String

  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categories       CategoryTeam[]
  dailyTasks       DailyTask[]
  dayCapacities    TeamDayCapacity[]
  productCapacities ProductTeamCapacity[]

  @@unique([name, companyId])
}

// Корректировка мощности бригады на конкретный день
model TeamDayCapacity {
  id     String   @id @default(cuid())
  teamId String
  date   DateTime
  factor Float
  note   String?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, date])
}

// Связь категория ↔ бригада (many-to-many)
model CategoryTeam {
  categoryId String
  teamId     String
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  team       Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([categoryId, teamId])
}

model Product {
  id             String  @id @default(cuid())
  code           String
  name           String
  categoryId     String
  companyId      String
  capacityPerDay Int?
  capacityLocked Boolean @default(false)
  barcode        String? // Штрихкод номенклатуры из 1С (РегистрСведений.ШтрихкодыНоменклатуры, МАКСИМУМ — как у Raytec)
  kind           String  @default("product") // product | component — своя комплектующая (полуфабрикат), заведена из состава изделий

  category       ProductCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  teamCapacities ProductTeamCapacity[]
  bomLines       BomLine[]            @relation("BomProduct")
  usedIn         BomLine[]            @relation("BomComponent")

  @@unique([code, companyId])
}

// --- Заказы ---

model Order {
  id          String    @id @default(cuid())
  orderNumber String
  customer    String
  description String?
  manager     String?
  paymentTerms String?
  approvedAt  DateTime?
  replanCount Int       @default(0)
  active      Boolean   @default(true)
  companyId   String
  orderRef    String?
  priority    Int       @default(20)
  raytecDate  DateTime?
  productionInfo String? // «Информация для производства» — ЗаказКлиента.Комментарий из 1С

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   OrderItem[]

  @@unique([orderRef, companyId])
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int
  groupNumber Int?
  transferDate DateTime? // Дата передачи строки (рткДатаПередачи, МАКСИМУМ по строкам товара) — ключ очереди; null — берётся дата заказа, без неё — сегодня
  // Снято с графика вручную (удаление задачи): столько штук автоматика сама не планирует,
  // пока позицию не вернут из списка «Не в графике». Кто, когда и с какой бригады сняли
  offPlanQty    Int       @default(0)
  offPlanAt     DateTime?
  offPlanBy     String?
  offPlanTeamId String?
  emptySlots    EmptySlot[]

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  dailyTasks DailyTask[]
}

// --- План и факт ---

model DailyTask {
  id              String   @id @default(cuid())
  orderItemId     String
  teamId          String?
  date            DateTime
  plannedQuantity Int      @default(0)
  loadShare       Float? // доля бригадо-дня от планировщика (непрерывное время, как у Raytec); null — считать plannedQuantity / мощность
  actualQuantity  Int?
  comment         String?
  manuallyPlaced  Boolean  @default(false)
  manualAt        DateTime? // когда задачу закрепили ручной правкой
  manualBy        String?   // кто закрепил (email пользователя)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([orderItemId, date])
}

// Производительность номенклатуры для конкретной бригады (шт/чел/день)
model ProductTeamCapacity {
  id             String @id @default(cuid())
  productId      String
  teamId         String
  companyId      String
  capacityPerDay Float // шт/чел/день, дробная: «Загрузка» из 1С бывает 2,5

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@unique([productId, teamId, companyId])
}

// Ячейка «оставлено пустым»: позицию перенесли с этого дня без заполнения освободившегося места.
// В «Графике» в её ячейке пишется «оставлено пустым», пока у бригады в этот день есть свободное место
model EmptySlot {
  id          String    @id @default(cuid())
  orderItemId String
  teamId      String?
  date        DateTime
  createdAt   DateTime  @default(now())
  createdBy   String?
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([orderItemId, date])
}

// Снимок плана для «Отменить» после «Вернуть в график» и переноса позиции целиком: задачи без факта
// затронутых бригад с даты from и самой позиции + её отметки. fingerprint — состояние сразу после действия:
// если план с тех пор менялся, отмена не применяется (чтобы не затереть чужие правки)
model PlanSnapshot {
  id          String   @id @default(cuid())
  companyId   String
  createdAt   DateTime @default(now())
  teamIds     String   // JSON: string[]
  fromDate    DateTime
  orderItemId String
  tasks       String   // JSON: задачи до действия
  item        String   // JSON: offPlan* и пометки «оставлено пустым» позиции до действия
  fingerprint String
}

// Реестр переносов: что, откуда, куда и кем перенесено вручную (перенос, разбивка, снятие с графика,
// возврат). Номер заказа, товар и бригады записаны текстом — запись остаётся, даже если заказ закрыли в 1С.
// kind: move | moveWhole | split | remove | removeWhole | return
model PlanMove {
  id           String    @id @default(cuid())
  companyId    String
  createdAt    DateTime  @default(now())
  createdBy    String?
  kind         String
  orderItemId  String
  orderId      String
  orderNumber  String
  customer     String
  productCode  String
  productName  String
  qty          Int
  days         Int       @default(1)
  fromDate     DateTime?
  fromDateEnd  DateTime?
  fromTeamName String?
  toDate       DateTime?
  toDateEnd    DateTime?
  toTeamName   String?
  filled       Boolean? // перенос: заполнили освободившееся место очередью или оставили пустым
  returnMode   String?  // возврат: fifo | date
  snapshotId   String?  // «Отменить» через снимок плана помечает запись отменённой
  undoneAt     DateTime?
  undoneBy     String?

  @@index([companyId, createdAt])
}

// Состав изделия из 1С (РесурсныеСпецификации.МатериалыИУслуги). Хозяин — 1С: при синке состав компании
// заменяется целиком. componentProductId — своя комплектующая (полуфабрикат), которую можно планировать;
// у покупных материалов он пустой.
model BomLine {
  id                 String  @id @default(cuid())
  companyId          String
  productId          String
  componentProductId String?
  materialCode       String
  materialName       String
  unit               String
  materialKind       String // ВидНоменклатуры: «Полуфабрикат», «Сырьё и материалы…»
  materialGroup      String? // «Производственная группа» материала — семейство для массовой настройки
  qtyPerUnit         Float // на 1 шт изделия: КоличествоУпаковок / ОсновноеИзделиеКоличествоУпаковок
  specCode           String?
  stage              String?

  product   Product  @relation("BomProduct", fields: [productId], references: [id], onDelete: Cascade)
  component Product? @relation("BomComponent", fields: [componentProductId], references: [id], onDelete: SetNull)

  @@index([companyId, productId])
  @@index([componentProductId])
}
