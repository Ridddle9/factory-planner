// Factory Planner — схема данных

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Авторизация ---

model Company {
  id        String   @id @default(cuid())
  inn       String   @unique
  name      String
  syncToken String   @unique
  createdAt DateTime @default(now())

  users                User[]
  workshops            Workshop[]
  categories           ProductCategory[]
  teams                Team[]
  products             Product[]
  orders               Order[]
  categoryBlocks       CategoryBlock[]
  productTeamCapacities ProductTeamCapacity[]
}

// role: ADMIN | MEMBER
// status: PENDING | APPROVED | REJECTED
model User {
  id           String   @id @default(cuid())
  email        String
  passwordHash String
  role         String   @default("MEMBER")
  status       String   @default("PENDING")
  companyId    String
  createdAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([email, companyId])
}

// --- Справочники ---

model Workshop {
  id        String  @id @default(cuid())
  name      String
  companyId String
  visible   Boolean @default(true)

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categories ProductCategory[]

  @@unique([name, companyId])
}

model ProductCategory {
  id                    String  @id @default(cuid())
  name                  String
  capacityPerTeamPerDay Int
  workshopId            String
  companyId             String
  visible               Boolean @default(true)

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  teams    CategoryTeam[]
  products Product[]
  blocks   CategoryBlock[]

  @@unique([name, companyId])
}

// Блокировка категории на период (нет запчастей, плановый простой и т.п.)
model CategoryBlock {
  id         String   @id @default(cuid())
  categoryId String
  companyId  String
  startDate  DateTime
  endDate    DateTime
  reason     String?

  category ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Team {
  id        String @id @default(cuid())
  name      String
  headcount Int    @default(1)
  companyId String

  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categories       CategoryTeam[]
  dailyTasks       DailyTask[]
  dayCapacities    TeamDayCapacity[]
  productCapacities ProductTeamCapacity[]

  @@unique([name, companyId])
}

// Корректировка мощности бригады на конкретный день
model TeamDayCapacity {
  id     String   @id @default(cuid())
  teamId String
  date   DateTime
  factor Float
  note   String?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, date])
}

// Связь категория ↔ бригада (many-to-many)
model CategoryTeam {
  categoryId String
  teamId     String
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  team       Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([categoryId, teamId])
}

model Product {
  id             String  @id @default(cuid())
  code           String
  name           String
  categoryId     String
  companyId      String
  capacityPerDay Int?
  capacityLocked Boolean @default(false)

  category       ProductCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  teamCapacities ProductTeamCapacity[]

  @@unique([code, companyId])
}

// --- Заказы ---

model Order {
  id          String    @id @default(cuid())
  orderNumber String
  customer    String
  description String?
  manager     String?
  paymentTerms String?
  approvedAt  DateTime?
  replanCount Int       @default(0)
  active      Boolean   @default(true)
  companyId   String
  orderRef    String?
  priority    Int       @default(20)
  raytecDate  DateTime?

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   OrderItem[]

  @@unique([orderRef, companyId])
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int
  groupNumber Int?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  dailyTasks DailyTask[]
}

// --- План и факт ---

model DailyTask {
  id              String   @id @default(cuid())
  orderItemId     String
  teamId          String?
  date            DateTime
  plannedQuantity Int      @default(0)
  actualQuantity  Int?
  comment         String?
  manuallyPlaced  Boolean  @default(false)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([orderItemId, date])
}

// Производительность номенклатуры для конкретной бригады (шт/чел/день)
model ProductTeamCapacity {
  id             String @id @default(cuid())
  productId      String
  teamId         String
  companyId      String
  capacityPerDay Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@unique([productId, teamId, companyId])
}
